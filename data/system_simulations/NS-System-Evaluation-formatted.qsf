        "CustomStyles": {
          "customCSS": ".Skin, .SkinInner {width:100% !important;}\n.Skin .QuestionOuter.Matrix{ max-width: 100%; }\n\n.question-display{\n  width: 100% !important;\n  min-width: 100% !important;\n}"
