      }
    },
    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID5",
      "SecondaryAttribute": "User's Vague Prompt \"Africa continues to draw a lot of attention.\" AI-Generated Chart Plan Popula...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  \n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Africa continues to draw a lot of attention.\"\n    </p>\n  </div>\n\n  \n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity of Africa Over Time</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity of Africa Over Time' line chart shows how the interest in visiting Africa has grown over the years, suggesting an increasing appeal of the continent for tourists.</p>\n    </div>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Comparative Popularity of Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Comparative Popularity of Regions' bar chart contrasts Africa's appeal with Asia and Europe, providing an understanding of how Africa's tourism performance stacks up against other regions.</p>\n    </div>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity vs Safety in Africa</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity vs Safety in Africa' scatter plot indicates the correlation between the popularity of African destinations and their safety ratings, allowing travelers to weigh their options carefully.</p>\n    </div>\n\n    <div>\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Africa's Popularity Breakdown by Country</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Pie chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Africa's Popularity Breakdown by Country' pie chart reveals the relative popularity of different African countries like Egypt, South Africa, and Morocco, offering insight into which destinations are the most frequented within the continent.</p>\n    </div>\n  </div>\n  </div>\n\n</div>",
