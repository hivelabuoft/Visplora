      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Consent Form\n    Study: Chart Plan Evaluation\n    By clicking \"I consent\" below,...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 24px auto; line-height: 1.6;\">\n  <div style=\"background:#f9fbfd; border:1px solid #d0d7de; border-radius:12px; padding:20px; margin-bottom:20px;\">\n    <h1 style=\"color:#0b6fa4; margin:0 0 8px;\">Consent Form</h1>\n    <p><b>Study:</b> Chart Plan Evaluation</p>\n    <p>By clicking \"I consent\" below, you agree to participate in this evaluation study.</p>\n  </div>\n</div>",
        "DataExportTag": "consent",
