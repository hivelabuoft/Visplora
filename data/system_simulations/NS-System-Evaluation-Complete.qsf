      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"The best travel spots align safety, cost, and cultural immersion. (Safety + Cost + Diversity – vague alignment)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Top Travel Spots by Safety and Cost</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Top Travel Spots by Safety and Cost' chart shows how Paris, Tokyo, and New York compare in terms of safety and average daily cost, offering valuable insight for travelers looking for a balance between cost and safety.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Cultural Diversity Across Popular Travel Spots</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Cultural Diversity Across Popular Travel Spots' bar chart indicates the richness of cultural diversity in Paris, Tokyo, and New York, helping travelers select a destination with the cultural experience they desire.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Cost-Safety-Diversity Overview for Top Travel Spots</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Cost-Safety-Diversity Overview for Top Travel Spots' chart presents a comprehensive comparison of travel cost, safety levels, and cultural diversity in Paris, Tokyo, and New York, serving as a one-stop source for travelers to make informed decisions.</p>\n    </div>\n  </div>\n</div>",
