      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Green places frequently receive rave reviews. (Env. quality + Reviews – unqualified rave)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environment Quality vs Rave Reviews</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environment Quality vs Rave Reviews' chart shows how regions with higher environmental quality tend to receive more rave reviews, suggesting that Asia, Europe, and North America with high quality environments are more likely to be well-received by travellers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Rave Reviews Distribution by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Pie chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Rave Reviews Distribution by Region' pie chart shows how rave reviews are distributed among different regions, helping travellers to identify the most popular regions based on review counts.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Trends of Rave Reviews in Green Places</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Trends of Rave Reviews in Green Places' line chart shows the increasing trend of rave reviews over time in green places like Seychelles, Costa Rica, and New Zealand, indicating the growing popularity of these sustainable travel destinations.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Comparison of Environment Quality in Popular Green Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Comparison of Environment Quality in Popular Green Destinations' bar chart compares the environmental quality of Seychelles, Costa Rica, and New Zealand, allowing travellers to make informed decisions based on environmental considerations.</p>\n    </div>\n  </div>\n</div>",
