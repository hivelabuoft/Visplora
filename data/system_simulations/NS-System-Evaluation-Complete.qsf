    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID161",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Environmental standards sometimes fall short in ...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Environmental standards sometimes fall short in places with high foot traffic. (Popularity + Env. quality – broad falling short)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity vs Environmental Quality by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity vs Environmental Quality by Region' chart provides a comparison between the number of visitors and environmental quality in Europe, Asia, and North America, helping travelers to choose destinations that balance tourist appeal with sustainability. </p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">High Foot Traffic Destinations with Low Environmental Standards</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'High Foot Traffic Destinations with Low Environmental Standards' bar chart shows that Paris, New York, and Tokyo attract a large number of tourists but have lower environmental standards, which is a crucial consideration for eco-conscious travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environmental Quality Index Over Time by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environmental Quality Index Over Time by Region' line chart shows how environmental quality in Europe, Asia, and North America has changed over time, informing travelers of regions that are improving in sustainability and those that aren't.</p>\n    </div>\n  </div>\n</div>",
