    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID155",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Many are surprised by how affordable unexplored ...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Many are surprised by how affordable unexplored destinations can be. (Cost + Popularity – unfathomable)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Average Daily Cost in Unexplored Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The bar chart reveals how surprisingly affordable daily travel costs can be in less-visited destinations such as Gabon, Guyana, and Bhutan.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity Score of Unexplored Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The line graph tracks the rising popularity of Gabon, Guyana, and Bhutan over time, suggesting these unexplored spots are gaining recognition among travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score vs Popularity Score of Unexplored Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The scatter plot depicts the relationship between safety and popularity scores of Gabon, Guyana, and Bhutan, showing that despite being less crowded, these places offer reasonable safety.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Sustainability Score of Unexplored Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Pie chart</i></p>\n      <p style=\"margin:4px 0;\">The pie chart presents the sustainability score of unexplored destinations like Gabon, Guyana, and Bhutan, highlighting their commitment to preserving their natural and cultural assets.</p>\n    </div>\n  </div>\n</div>",
