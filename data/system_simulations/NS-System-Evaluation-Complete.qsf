    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID113",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Satisfying trips blend safety, culture, and cost...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Satisfying trips blend safety, culture, and cost-effectiveness. (Safety + Diversity + Cost – vague satisfaction)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety and Diversity by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety and Diversity by Region' chart displays how different regions like Asia, Africa, and Europe score in terms of safety and cultural diversity, helping travelers to choose a destination that is both safe and culturally enriching.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Average Daily Cost by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Average Daily Cost by Region' bar chart provides a comparison of the average daily travel expenses in Asia, Africa, and Europe, giving an idea about the cost-effectiveness of each region.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety vs Popularity Bubble Plot</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety vs Popularity Bubble Plot' scatter chart illustrates the relationship between the safety scores and popularity of different destinations in Asia, Africa, and Europe, helping travelers assess the safety level relative to the popularity of a place.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">World Map of Review Scores</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Map chart</i></p>\n      <p style=\"margin:4px 0;\">The 'World Map of Review Scores' shows the average review scores for travel destinations in China, India, and the United States, allowing travelers to select a place with high satisfaction ratings.</p>\n    </div>\n  </div>\n</div>",
