    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID157",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Safety in obscure regions is often unexpectedly ...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Safety in obscure regions is often unexpectedly reassuring. (Safety + Popularity – unexpected reassuring)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score in Obscure Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score in Obscure Regions' bar chart reveals that lesser-known destinations like Greenland, Mongolia, and Bhutan have surprisingly high safety scores, providing reassurance for potential visitors.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity versus Safety in Obscure Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity versus Safety in Obscure Regions' scatter plot shows that despite their low popularity, these obscure regions of Greenland, Mongolia, and Bhutan have a high level of safety, suggesting that they could be hidden gems for adventurous travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety and Popularity Trends in Obscure Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety and Popularity Trends in Obscure Regions' multi-type chart displays how both safety levels and popularity of Greenland, Mongolia, and Bhutan have changed over time, offering travelers insights into the growing appeal of these destinations.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Unexpected Reassuring Factors in Obscure Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Pie chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Unexpected Reassuring Factors in Obscure Regions' pie chart identifies various unanticipated factors that contribute to the sense of reassurance in traveling to Greenland, Mongolia, and Bhutan, assisting travelers in understanding what makes these regions appealing.</p>\n    </div>\n  </div>\n</div>",
