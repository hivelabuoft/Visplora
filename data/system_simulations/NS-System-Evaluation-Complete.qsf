      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Discovering sanctuary in offbeat areas can be astonishing. (Safety + Popularity – unexpected astonishment)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score vs Popularity Score</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score vs Popularity Score' scatter chart illustrates the relationship between safety and popularity for three offbeat destinations: Tibet, Bhutan, and Madagascar, which can help travelers assess which less-visited areas provide both security and intriguing experiences.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity Score Over Time</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity Score Over Time' line chart displays how the popularity of Tibet, Bhutan, and Madagascar has evolved over time, providing a glimpse into their growing appeal among travelers seeking unconventional destinations.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score Distribution</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Pie chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score Distribution' pie chart provides a comparative view of safety scores among Tibet, Bhutan, and Madagascar, offering insights into which offbeat areas prioritize tourist safety.</p>\n    </div>\n  </div>\n</div>",
