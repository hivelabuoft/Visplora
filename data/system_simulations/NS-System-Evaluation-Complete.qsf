    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID35",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Some costly destinations are surprisingly under ...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Some costly destinations are surprisingly under the radar.\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Costly Yet Unpopular Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Costly Yet Unpopular Destinations' scatter chart reveals that Bhutan, Antarctica, and Greenland, despite their high average daily costs, have surprisingly low popularity scores among travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Review Count of Costly Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Review Count of Costly Destinations' bar chart shows that Bhutan, Antarctica, and Greenland, although expensive, receive a relatively small number of traveler reviews, indicating they may be less frequented or less known.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score of Costly Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score of Costly Destinations' bar chart demonstrates that despite their high cost, Bhutan, Antarctica, and Greenland have varying safety scores, which is an important consideration when planning an expensive trip.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Visitor Flow to Costly Destinations Over Time</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Visitor Flow to Costly Destinations Over Time' line chart shows the trends in tourist arrivals to Bhutan, Antarctica, and Greenland over time, reflecting the changing interest in these high-cost destinations.</p>\n    </div>\n  </div>\n</div>",
