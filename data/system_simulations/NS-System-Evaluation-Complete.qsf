    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID193",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Successful trips blend budget-friendly options w...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Successful trips blend budget-friendly options with safety and cultural elements. (Cost + Safety + Diversity – vague success)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Average Daily Cost by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Average Daily Cost by Region' bar chart compares the average daily travel costs in Asia, Europe, and North America, providing a clear picture of the most and least expensive regions for travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score vs Popularity</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The scatter plot titled 'Safety Score vs Popularity' shows the relationship between the safety of a destination and its popularity among travelers, with the size of each point indicating the number of reviews, helping travelers to balance safety with popular tourist spots.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Diversity Index by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Diversity Index by Region' bar chart shows the cultural diversity in Asia, Europe, and North America, which could help travelers choose a destination based on cultural richness and variety.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Region's Popularity and Environment Quality</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Region's Popularity and Environment Quality' multiType chart combines popularity scores with environmental quality indices for Asia, Europe, and North America, enabling travelers to select destinations that are both popular and environmentally friendly.</p>\n    </div>\n  </div>\n</div>",
