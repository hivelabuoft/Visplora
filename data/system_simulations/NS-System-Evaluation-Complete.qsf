    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID195",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Affordable yet less-discussed spots can surprise...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Affordable yet less-discussed spots can surprise travelers. (Cost + Popularity – unforeseen)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Average Daily Cost by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Average Daily Cost by Region' bar chart shows that Slovenia, Uruguay, and Bhutan are surprisingly affordable travel destinations, making them great options for budget-conscious travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity Score vs Safety Score</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity Score vs Safety Score' scatter plot reveals that there's no direct correlation between the safety and popularity of Slovenia, Uruguay, and Bhutan: these regions maintain a good safety score even though they aren't the most popular tourist spots.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Review Count Across Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Review Count Across Regions' bar chart shows that Slovenia, Uruguay, and Bhutan, despite being less-discussed, have received a considerable number of reviews, hinting at an under-the-radar appeal among travelers.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environmental Quality Index Over Time</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environmental Quality Index Over Time' line chart indicates that the environmental quality in Slovenia, Uruguay, and Bhutan has been steadily improving over the years, making these destinations an excellent choice for eco-friendly travelers.</p>\n    </div>\n  </div>\n</div>",
