    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID25",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Environmental conditions appear to favor coastal...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Environmental conditions appear to favor coastal areas. \"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environmental Quality of Coastal Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environmental Quality of Coastal Regions' bar chart indicates that among the coastal regions, Maine has the highest environmental quality, followed by California and Florida. This information may be useful for travelers who prioritize environmental health in their destination choices.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Comparison of Environmental Quality and Review Scores</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Comparison of Environmental Quality and Review Scores' chart reveals that places with better environmental quality, such as Maine and California, also tend to have higher travel review scores. This suggests that a cleaner environment could enhance the overall travel experience.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environmental Quality Over Time</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environmental Quality Over Time' line chart shows that the environmental quality in all three coastal regions has generally improved over the past few years. This positive trend might encourage more eco-conscious travelers to visit these areas.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity Score vs Environmental Quality</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity Score vs Environmental Quality' scatter plot suggests a positive correlation between a destination's popularity and its environmental quality. Therefore, popular destinations like California and Maine also offer better environmental conditions.</p>\n    </div>\n  </div>\n</div>",
