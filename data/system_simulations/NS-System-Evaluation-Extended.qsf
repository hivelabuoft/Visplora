    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID39",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Finding a diverse place that’s also budget-frien...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Finding a diverse place that’s also budget-friendly can be unexpected.\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Diverse and Budget-friendly Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Diverse and Budget-friendly Destinations' bar chart compares the average daily costs in Paris, Tokyo, and New York, ranked according to their diversity index. This helps you identify diverse cities that also align with your budget.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Diverse and Unexpected Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Diverse and Unexpected Destinations' scatter chart reveals how safety and popularity scores in Paris, Tokyo, and New York are related, with the size of the points reflecting the number of reviews. This can guide you to safe, diverse locations that may be less crowded.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Diversity Index Over Time</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Diversity Index Over Time' line chart displays the monthly changes in cultural diversity in Paris, Tokyo, and New York. This can help you plan your travel timing to enjoy a diverse cultural experience.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popular and Diverse Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popular and Diverse Destinations' chart combines a bar and line graph to show the popularity and environmental quality of Paris, Tokyo, and New York. This can help you choose a destination that's popular but also environmentally friendly.</p>\n    </div>\n  </div>\n</div>",
