    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID31",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"There’s often a connection between environmental...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"There’s often a connection between environmental quality and high reviews.\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environmental Quality vs Review Score by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environmental Quality vs Review Score by Region' scatter plot shows how review scores tend to increase with better environmental quality in Asia, Europe, and North America. This could influence travelers to opt for destinations with higher environmental quality to ensure a better travel experience.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Average Environmental Quality by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The bar chart 'Average Environmental Quality by Region' reveals the environmental quality index for Asia, Europe, and North America. This can help travelers who prioritize environmentally conscious destinations make informed decisions.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Average Review Score by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">In the 'Average Review Score by Region' bar chart, we can see the average user review scores for destinations in Asia, Europe, and North America. This can guide travelers towards regions with higher ratings for a presumably better travel experience.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Environmental Quality and Review Score Trends</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Environmental Quality and Review Score Trends' chart illustrates how environmental quality and review scores have changed over time in Asia, Europe, and North America. This can help travelers understand trends and plan trips based on improving or declining environmental and review scores.</p>\n    </div>\n  </div>\n</div>",
