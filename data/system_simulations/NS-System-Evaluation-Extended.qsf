    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID45",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"Northern regions are believed to be especially s...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Northern regions are believed to be especially safe. (Safety – vague belief)\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score by Northern Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score by Northern Regions' bar chart shows that Scandinavia, Northern Canada, and Alaska all have high safety scores, making them safe travel destinations.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Comparative Safety Across Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Comparative Safety Across Regions' scatter chart reveals that while all these regions are generally safe, Scandinavia is relatively safer compared to Northern Canada and Alaska.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety and Popularity in Northern Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety and Popularity in Northern Regions' multi-type chart indicates that while these destinations are safe, Scandinavia is both safer and more popular among tourists.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Over Time in Northern Regions</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Over Time in Northern Regions' line chart demonstrates that the safety levels in Scandinavia, Northern Canada, and Alaska have remained consistently high over time, suggesting they are reliable choices for safe travel.</p>\n    </div>\n  </div>\n</div>",
