    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID37",
      "SecondaryAttribute": "User's Vague Prompt\n    \n      \"The safety of some little-known places can be as...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"The safety of some little-known places can be astonishing.\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Unexpectedly Safe Destinations</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Unexpectedly Safe Destinations' bar chart reveals that Bhutan, the Faroe Islands, and Mongolia have surprisingly high safety scores, making them secure travel destinations.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Popularity vs Safety</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Popularity vs Safety' scatter plot shows that while Bhutan, the Faroe Islands, and Mongolia may not be the most popular travel destinations, they boast impressive safety ratings.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Perception Map</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Map chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Perception Map' offers a geographical representation of safety scores, underscoring that Bhutan, the Faroe Islands, and Mongolia are perceived as safe, even though they are lesser known.</p>\n    </div>\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety and Review Analysis</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Multi-type chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety and Review Analysis' multiType chart indicates that despite their off-the-beaten-path status, Bhutan, the Faroe Islands, and Mongolia have strong safety scores and positive reviews, suggesting they are worth considering for your next travel adventure.</p>\n    </div>\n  </div>\n</div>",
