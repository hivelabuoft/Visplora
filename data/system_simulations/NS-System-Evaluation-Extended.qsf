          "overrides": null
        },
        "NewScoring": 1,
        "SurveyMetaDescription": "The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.",
        "CustomStyles": {
          "customCSS": ".Skin, .SkinInner {width:100% !important;}\n.Skin .QuestionOuter.Matrix{ max-width: 100%; }\n\n.question-display{\n  width: 100% !important;\n  min-width: 100% !important;\n}"
