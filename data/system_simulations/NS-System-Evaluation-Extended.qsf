    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "Consent Form for System Evaluation Student Principal Investigator: Oliver Huang, University of To...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 24px auto; line-height: 1.6;\">\n\n  \n  <div style=\"background:#f9fbfd; border:1px solid #d0d7de; border-radius:12px; padding:20px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06);\">\n    <h1 style=\"color:#0b6fa4; margin:0 0 8px;\">Consent Form for System Evaluation</h1>\n    <p style=\"margin:4px 0;\"><b>Student Principal Investigator:</b> Oliver Huang, University of Toronto</p>\n    <p style=\"margin:4px 0;\"><b>Study Title:</b> Exploring Data Narratives with Interactive Analysis Tools</p>\n    <p style=\"margin:4px 0;\"><b>Supported By:</b> University of Toronto</p>\n  </div>\n\n  \n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:18px;\">\n    <h2 style=\"color:#0f6cab; margin-top:0;\">What is this study about?</h2>\n    <p>\n      You are invited to participate in a study evaluating how people turn <b>vague questions or hunches</b> into\n      <b>charts and insights</b> using an interactive analysis system. \n      We are studying how different scaffolds support <b>exploration, reflection, and reasoning</b>.\n    </p>\n  </div>\n\n  \n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:18px;\">\n    <h2 style=\"color:#0f6cab; margin-top:0;\">What will I do?</h2>\n    <ul>\n      <li>Work with the system to explore data, starting from vague prompts (e.g., “Africa continues to draw attention”).</li>\n      <li>Check and refine charts suggested by the system.</li>\n      <li>Provide feedback on how easy it was to explore, reflect, and explain reasoning.</li>\n    </ul>\n    <p>The session will take about <b>30-40 minutes</b>.</p>\n  </div>\n\n  \n  <div style=\"background:#fffef7; border:1px solid #f0e6b6; border-radius:10px; padding:20px; margin-bottom:18px;\">\n    <h2 style=\"color:#7a5c00; margin-top:0;\">Risks & Benefits</h2>\n    <p>\n      There are <b>no known risks</b> to participating. Your responses may help improve the design of future\n      tools for data exploration and reasoning. You may also find the process useful for reflecting on your own\n      decision-making.\n    </p>\n  </div>\n\n  \n  <div style=\"background:#fffef7; border:1px solid #f0e6b6; border-radius:10px; padding:20px; margin-bottom:18px;\">\n    <h2 style=\"color:#7a5c00; margin-top:0;\">Voluntary Participation</h2>\n    <p>\n      Taking part is voluntary. You may withdraw at any time without penalty. Your data will be kept confidential\n      and analyzed only in aggregate.\n    </p>\n  </div>\n\n  \n  <div style=\"background:#e8f5e9; border:1px solid #a5d6a7; border-radius:10px; padding:20px; box-shadow:0 2px 6px rgba(0,0,0,0.04);\">\n    <p style=\"margin:0; font-weight:bold;\">\n      By clicking “I consent” below, you confirm that you are at least 18 years old and agree to participate in this system evaluation study. \n      Participation is voluntary, and you may withdraw at any time without penalty.\n    </p>\n  </div>\n\n</div>\n",
        "DataExportTag": "consent",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Consent Form for System Evaluation Student Principal Investigator: Oliver Huang, University of To...",
        "Choices": {
          "1": {
            "Display": "I consent"
          },
          "2": {
            "Display": "I do not consent"
          }
        },
        "ChoiceOrder": [
          "1",
          "2"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
        },
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID1"
      }
    },
    {
      "SurveyID": "SV_cT0X9SSp3DlWBJI",
      "Element": "SQ",
      "PrimaryAttribute": "QID2",
      "SecondaryAttribute": "User's Vague Prompt \"Certain regions are reportedly safer than others.\" AI-Generated Chart Plan S...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"font-family: Arial, sans-serif; margin: 24px auto; line-height: 1.6;\">\n\n  <div style=\"background:#fff3cd; border:1px solid #f0c36d; border-radius:12px; padding:24px; margin-bottom:20px; box-shadow:0 2px 6px rgba(0,0,0,0.06); text-align:center;\">\n    <h2 style=\"color:#7a5c00; margin:0; font-size:22px;\">User's Vague Prompt</h2>\n    <p style=\"margin:10px 0 0; font-size:20px; font-weight:bold; color:#333;\">\n      \"Certain regions are reportedly safer than others.\"\n    </p>\n  </div>\n\n  <div style=\"background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:24px;\">\n    <h3 style=\"color:#0f6cab; margin-top:0; font-size:18px;\">AI-Generated Chart Plan</h3>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score by Region</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bar chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score by Region' bar chart reveals how different regions rank in terms of safety, with North America, Europe, and Asia each having distinct safety scores, which can help you prioritize safety in your travel planning.</p>\n    </div>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety vs Popularity</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Bubble chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety vs Popularity' scatter plot shows the relationship between safety scores and popularity scores for North America, Europe, and Asia, highlighting that popular destinations may not always be the safest.</p>\n    </div>\n\n    <div style=\"margin-bottom:16px;\">\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score Trends</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Line chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score Trends' line chart shows how safety scores for North America, Europe, and Asia have changed over time, allowing you to understand the safety trajectory of these regions for future travel planning.</p>\n    </div>\n\n    <div>\n      <p style=\"margin:0; font-weight:bold; font-size:16px;\">Safety Score Distribution</p>\n      <p style=\"margin:2px 0; color:#555;\"><i>Pie chart</i></p>\n      <p style=\"margin:4px 0;\">The 'Safety Score Distribution' pie chart illustrates the proportion of safety scores across North America, Europe, and Asia, giving you a quick overview of safety distribution to guide your destination selection.</p>\n    </div>\n  </div>\n</div>",
