{
  "demoRequests": [
    {
      "name": "Travel Expense Breakdown by Budget",
      "request": {
        "userQuery": "Show how travel expenses vary by budget level with interactive filtering",
        "constraints": {
          "chartType": "pie",
          "subtype": "interactivePieSpec",
          "nodeSize": "medium",
          "dataCategory": "cost",
          "destinations": ["Paris"],
          "maxDataPoints": 5,
          "hasFieldFilter": true,
          "filterConfig": {
            "filterType": "budget_level",
            "filterKey": "selectedBudgetLevel",
            "filterLabel": "Budget Level",
            "defaultValue": "Mid-range",
            "options": [
              { "label": "Budget", "value": "Budget", "displayName": "Budget Travel" },
              { "label": "Mid-range", "value": "Mid-range", "displayName": "Mid-range Travel" },
              { "label": "Luxury", "value": "Luxury", "displayName": "Luxury Travel" }
            ]
          }
        }
      }
    },
    {
      "name": "Tourist Origin by Region",
      "request": {
        "userQuery": "Analyze tourist origin distribution with regional filtering",
        "constraints": {
          "chartType": "pie",
          "subtype": "interactivePieSpec",
          "nodeSize": "medium",
          "dataCategory": "visitor-flow",
          "destinations": ["Dubai", "Singapore"],
          "maxDataPoints": 6,
          "hasFieldFilter": true,
          "filterConfig": {
            "filterType": "region",
            "filterKey": "selectedRegion",
            "filterLabel": "Destination Region",
            "defaultValue": "Asia",
            "options": [
              { "label": "North America", "value": "North America", "displayName": "North America" },
              { "label": "Europe", "value": "Europe", "displayName": "Europe" },
              { "label": "Asia", "value": "Asia", "displayName": "Asia" },
              { "label": "South America", "value": "South America", "displayName": "South America" }
            ]
          }
        }
      }
    },
    {
      "name": "Travel Activity Distribution by Season",
      "request": {
        "userQuery": "Show travel activity preferences across different seasons",
        "constraints": {
          "chartType": "pie",
          "subtype": "interactivePieSpec",
          "nodeSize": "medium",
          "dataCategory": "reviews",
          "destinations": ["Tokyo", "Barcelona"],
          "maxDataPoints": 5,
          "hasFieldFilter": true,
          "filterConfig": {
            "filterType": "season",
            "filterKey": "selectedSeason",
            "filterLabel": "Travel Season",
            "defaultValue": "Summer",
            "options": [
              { "label": "Spring", "value": "Spring", "displayName": "Spring (Mar-May)" },
              { "label": "Summer", "value": "Summer", "displayName": "Summer (Jun-Aug)" },
              { "label": "Fall", "value": "Fall", "displayName": "Fall (Sep-Nov)" },
              { "label": "Winter", "value": "Winter", "displayName": "Winter (Dec-Feb)" }
            ]
          }
        }
      }
    },
    {
      "name": "Safety Concerns by Trip Type",
      "request": {
        "userQuery": "Analyze safety concern distribution filtered by trip type",
        "constraints": {
          "chartType": "pie",
          "subtype": "interactivePieSpec",
          "nodeSize": "medium",
          "dataCategory": "safety",
          "destinations": ["Bangkok", "Cairo"],
          "maxDataPoints": 6,
          "hasFieldFilter": true,
          "filterConfig": {
            "filterType": "trip_type",
            "filterKey": "selectedTripType",
            "filterLabel": "Trip Type",
            "defaultValue": "Leisure",
            "options": [
              { "label": "Business", "value": "Business", "displayName": "Business Travel" },
              { "label": "Leisure", "value": "Leisure", "displayName": "Leisure Travel" },
              { "label": "Adventure", "value": "Adventure", "displayName": "Adventure Travel" },
              { "label": "Cultural", "value": "Cultural", "displayName": "Cultural Travel" }
            ]
          }
        }
      }
    }
  ]
}